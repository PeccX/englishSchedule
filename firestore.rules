rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Demo: cualquier usuario autenticado lee y escribe. En producción cada colección
    // tendría reglas propias (catálogo solo lectura, lecciones solo del dueño, etc.).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
